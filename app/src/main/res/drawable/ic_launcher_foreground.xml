<?xml version="1.0" encoding="utf-8"?>
<!--
  A business card inside viewfinder brackets.

  All artwork sits within the central 66dp of the 108dp viewport, which is the area adaptive
  icons guarantee is visible whatever shape a launcher masks to.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Viewfinder brackets -->
    <path
        android:pathData="M28,45 L28,34 L39,34"
        android:strokeColor="#5AD7E8"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M69,34 L80,34 L80,45"
        android:strokeColor="#5AD7E8"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M28,63 L28,74 L39,74"
        android:strokeColor="#5AD7E8"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M69,74 L80,74 L80,63"
        android:strokeColor="#5AD7E8"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The card -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,43 h28 a3,3 0 0 1 3,3 v16 a3,3 0 0 1 -3,3 h-28 a3,3 0 0 1 -3,-3 v-16 a3,3 0 0 1 3,-3 z" />

    <!-- Name, then a detail line -->
    <path
        android:pathData="M43,50 L59,50"
        android:strokeColor="#12263F"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M43,58 L53,58"
        android:strokeColor="#8A9BB5"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
